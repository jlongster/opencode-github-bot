{
    "name": "opencode-github-bot",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "typecheck": "tsc -p tsconfig.json",
        "lint": "biome check .",
        "format": "biome format --write .",
        "test": "vitest run",
        "build": "bun run build.ts",
        "smoke": "bun run smoke.ts",
        "start": "node dist/main.mjs",
        "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run smoke"
    },
    "dependencies": {
        "@effect/platform-node": "4.0.0-rc.112",
        "@opencode/core": "2.0.22",
        "@opencode/sdk": "2.0.22",
        "effect": "4.0.0-rc.112"
    },
    "overrides": {
        "@effect/platform-node-shared": "4.0.0-rc.112"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.12",
        "@opencode/ai": "2.0.22",
        "@types/bun": "1.3.14",
        "@types/node": "26.4.1",
        "typescript": "7.0.2",
        "vitest": "4.1.11"
    }
}
